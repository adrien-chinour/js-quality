{
  "name": "@adrien-chinour/js-quality",
  "version": "0.2.0",
  "description": "Advanced quality gates for JS/TS projects: cognitive complexity, CRAP, duplication, mutation.",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrien-chinour/js-quality.git"
  },
  "bin": {
    "jsq": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "qa": "vp check --deny-warnings && vp test run --coverage && node src/cli.ts check",
    "mutation": "node src/cli.ts mutation",
    "prepack": "vp pack"
  },
  "dependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "jscpd": "5.4.3",
    "oxc-parser": "0.158.0",
    "oxlint": "1.93.0",
    "tinyglobby": "0.2.17"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "vite-plus": "1.6.0",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "vitest": ">=5.1.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24"
    }
  }
}
